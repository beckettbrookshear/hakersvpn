{
  "manifest_version": 3,
  "name": "HakersVPN",
  "version": "1.0.0",
  "description": "Route all browser traffic through your own HakersVPN server.",
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HakersVPN" }
}
